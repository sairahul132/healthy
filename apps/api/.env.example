# Copy to .env for local development. Never commit the real .env.
#
# This variant is for running the API directly with `uvicorn` (no Docker) —
# see README.md. Inside docker-compose, the root .env.example's Postgres/
# Redis URLs are used instead via env_file: .env in docker-compose.yml.

ENVIRONMENT=development

DATABASE_URL=sqlite+aiosqlite:///./healthy_dev.db
REDIS_URL=redis://localhost:6379/0

JWT_SIGNING_KEY=dev-only-change-me-00000000000000000000000000000000
FIELD_ENCRYPTION_KEY=dev-only-change-me-00000000000000000000000000000000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

OTP_PROVIDER=mock
# Development UI mode only: accepts any 6-digit code and does not send OTPs.
# Never enable this with ENVIRONMENT=production.
OTP_BYPASS_ENABLED=false
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Development-only static fixtures when OTP_BYPASS_ENABLED=true.
# OTP_STATIC_LOGIN_NUMBERS=9876543210,1234567890
# OTP_STATIC_LOGIN_CODE=123456
# OTP_STATIC_SHARE_NUMBERS=9999988888,4444455555
# OTP_STATIC_SHARE_CODE=098765
# Set OTP_STATIC_TEST_ACCOUNTS_ENABLED=true only when you intentionally need
# these exact test accounts in a deployed test environment. Never use them
# for real users.

# Production SMS OTP via Twilio. Keep these values in the host's secret
# manager and set OTP_PROVIDER=twilio in production.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567

# Low-volume email OTP via Gmail SMTP. Use a Google App Password, not your
# normal Gmail password. Set OTP_PROVIDER=gmail in the deployment environment.
# GMAIL_ADDRESS=your-app@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop

# STORAGE_PROVIDER=local writes to STORAGE_LOCAL_DIR on disk instead — the
# no-MinIO-needed local dev default, same portability idea as SQLite for DATABASE_URL.
STORAGE_PROVIDER=s3_compatible
# Production example for Cloudflare R2:
# STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
STORAGE_BUCKET=healthy-documents
STORAGE_ACCESS_KEY=healthy_dev
STORAGE_SECRET_KEY=healthy_dev_only
STORAGE_REGION=us-east-1
STORAGE_LOCAL_DIR=./storage

# No AV engine available for local dev — VIRUS_SCAN_PROVIDER=mock still rejects
# the EICAR test file for real (app/providers/virus_scan_provider.py).
VIRUS_SCAN_PROVIDER=mock

CORS_ALLOW_ORIGINS=http://localhost:3000
SHARE_LINK_BASE_URL=http://localhost:3000/s
