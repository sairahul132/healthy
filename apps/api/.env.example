# Copy to .env for local development. Never commit the real .env.
#
# This variant is for running the API directly with `uvicorn` (no Docker) —
# see README.md. Inside docker-compose, the root .env.example's Postgres/
# Redis URLs are used instead via env_file: .env in docker-compose.yml.

ENVIRONMENT=development

DATABASE_URL=sqlite+aiosqlite:///./healthy_dev.db
REDIS_URL=redis://localhost:6379/0

JWT_SIGNING_KEY=dev-only-change-me-00000000000000000000000000000000
FIELD_ENCRYPTION_KEY=dev-only-change-me-00000000000000000000000000000000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

OTP_PROVIDER=mock
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

STORAGE_PROVIDER=s3_compatible
STORAGE_BUCKET=healthy-documents
STORAGE_ACCESS_KEY=healthy_dev
STORAGE_SECRET_KEY=healthy_dev_only
STORAGE_REGION=us-east-1

CORS_ALLOW_ORIGINS=http://localhost:3000
SHARE_LINK_BASE_URL=http://localhost:3000/s
