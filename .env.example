# Copy to .env for local development. Never commit the real .env (see .gitignore).
# In staging/production these come from a proper secrets manager, not a file.

ENVIRONMENT=development

# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://healthify:healthify_dev_only@postgres:5432/healthify

# --- Redis (sessions/rate-limiting) ---
REDIS_URL=redis://redis:6379/0

# --- Auth / crypto ---
# Dev-only values. Generate real ones with `openssl rand -hex 32` per environment;
# never reuse a value across environments.
JWT_SIGNING_KEY=dev-only-change-me-00000000000000000000000000000000
FIELD_ENCRYPTION_KEY=dev-only-change-me-00000000000000000000000000000000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- OTP provider ---
# OTP_PROVIDER=mock logs codes to the API console instead of sending SMS/email.
# Switch to a real provider (e.g. OTP_PROVIDER=twilio) once credentials exist.
OTP_PROVIDER=mock
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# --- Object storage (S3-compatible; MinIO locally) ---
STORAGE_PROVIDER=s3_compatible
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_BUCKET=healthify-documents
STORAGE_ACCESS_KEY=healthify_dev
STORAGE_SECRET_KEY=healthify_dev_only
STORAGE_REGION=us-east-1

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
